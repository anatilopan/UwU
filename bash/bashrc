# .bashrc - IT Manager / Python Dev Optimized

# 1. Global definitions
[[ -f /etc/bashrc ]] && . /etc/bashrc

# 2. Path Deduplication & Construction
paths=(
    "$HOME/.local/bin"
    "$HOME/bin"
    "$HOME/develop/flutter/bin"
    "$HOME/develop/android-studio/bin"
)

for p in "${paths[@]}"; do
    [[ ":$PATH:" != *":$p:"* ]] && export PATH="$p:$PATH"
done

# 3. Modular Sourcing (Aliases, Functions, etc.)
# This will pick up ~/.bashrc.d/aliases.sh automatically
if [ -d ~/.bashrc.d ]; then
    for rc in ~/.bashrc.d/*.sh; do
        [[ -f "$rc" ]] && . "$rc"
    done
fi

# 4. Tool Initializations (Dependencies)
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
command -v pyenv &>/dev/null && eval "$(pyenv init - bash)"

# 5. Shell Prompt
if command -v oh-my-posh &>/dev/null; then
    eval "$(oh-my-posh init bash --config "$HOME/Documents/Personal/Projects/UwU/joe_omp.json")"
fi
[[ -f "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# 6. zoxide: `z <part-of-path>` jumps to frequently used dirs, `zi` picks with fzf
# Must come after the prompt init, which would otherwise overwrite zoxide's PROMPT_COMMAND hook
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

# 7. Startup reminder for tools or files this config expects but can't find
if [[ $- == *i* ]]; then
    missing=()
    for tool in pyenv oh-my-posh zoxide fzf bat; do
        command -v "$tool" &>/dev/null || missing+=("$tool")
    done
    [[ -f "$HOME/.cargo/env" ]] || missing+=("cargo")
    [[ -f "$HOME/.bashrc.d/aliases.sh" ]] || missing+=("~/.bashrc.d/aliases.sh")
    (( ${#missing[@]} )) && echo "⚠ bashrc: missing ${missing[*]} (see UwU/README.md)"
    unset missing tool
fi
